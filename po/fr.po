#: data/io.github.mibi88.MibiMdEditor.desktop.in:2
msgid "MibiMdEditor"
msgstr "MibiMdEditor"

#: data/io.github.mibi88.MibiMdEditor.appdata.xml.in:7
msgid "Prepare your texts for the web."
msgstr "Préparez vos textes pour le web !"

#: data/io.github.mibi88.MibiMdEditor.gschema.xml:5
msgid "Does the text editor has a grid background?"
msgstr "L'éditeur de texte a-t-il une grille en arrière-plan ?"

#: data/io.github.mibi88.MibiMdEditor.gschema.xml:6
msgid "If the text editor has a grid background."
msgstr "Si l'éditeur de texte a une grille en arrière-plan."

#: data/io.github.mibi88.MibiMdEditor.gschema.xml:13
msgid "Is current line highlighted in the text editor?"
msgstr "La ligne actuelle est-elle surlignée dans l'éditeur de texte ?"

#: data/io.github.mibi88.MibiMdEditor.gschema.xml:14
msgid "If current line is highlighted in the text editor."
msgstr "Si la ligne actuelle est surlignée dans l'éditeur de texte."

#: data/io.github.mibi88.MibiMdEditor.gschema.xml:21
msgid "Does the text editor indents automatically the new line?"
msgstr "L'indentation automatique est-elle activée dans l'éditeur ?"

#: data/io.github.mibi88.MibiMdEditor.gschema.xml:24
msgid "If the text editor indents automatically a new line."
msgstr "Si l'indentation automatique est activée dans l'éditeur."

#: data/io.github.mibi88.MibiMdEditor.gschema.xml:31
msgid "Does the text editor uses a monospaced font to display his content?"
msgstr ""
"L'éditeur utilise-t-il une police à chasse fixe pour afficher le texte ?"

#: data/io.github.mibi88.MibiMdEditor.gschema.xml:34
msgid ""
"If the text editor uses a monospaced font instead of a proportional one."
msgstr "Si l'éditeur utilise une police à chasse fixe pour afficher le texte."

#: data/io.github.mibi88.MibiMdEditor.gschema.xml:41
msgid "Names of the different scripts to generate HTML."
msgstr "Noms des différents scripts pour générer du HTML."

#: data/io.github.mibi88.MibiMdEditor.gschema.xml:44
msgid ""
"The names of the different scripts to generate HTML from other markup "
"languages."
msgstr ""
"Le noms des différents scripts pour générer du HTML à partir d'autres "
"langages de balisage."

#: data/io.github.mibi88.MibiMdEditor.gschema.xml:51
msgid "Files of the different scripts to generate HTML."
msgstr "Fichiers des différents scripts pour générer du HTML."

#: data/io.github.mibi88.MibiMdEditor.gschema.xml:54
msgid ""
"The files of the different scripts to generate HTML from other markup "
"languages."
msgstr ""
"Les fichiers des différents scripts pour générer du HTML à partir d'autres "
"langages de balisage."

#: data/io.github.mibi88.MibiMdEditor.gschema.xml:61
#: data/io.github.mibi88.MibiMdEditor.gschema.xml:64
msgid ""
"Language name for the syntax highlighting for the markup languages parsed by "
"the scripts to generate HTML."
msgstr ""
"Nom du langage pour la coloration syntaxique pour les langages de balisage "
"lus par les scripts pour générer du HTML."

